{
  "name": "cymor-todo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CYMOR TO-DO backend: Express API, scheduling/notification core, separate push worker.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:mongo": "tsx --test tests/mongoStore.test.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/workerMain.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/workerMain.ts",
    "generate-vapid": "web-push generate-vapid-keys",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
