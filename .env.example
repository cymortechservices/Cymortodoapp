# ---- backend/.env (never commit real values) ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/cymor-todo      # Atlas connection string in production
JWT_ACCESS_SECRET=            # >=16 random chars; REQUIRED in production (server refuses default secrets)
JWT_REFRESH_SECRET=           # a different random string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
VAPID_PUBLIC_KEY=             # npm run generate-vapid (inside backend/)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
FIREBASE_SERVICE_ACCOUNT=     # one-line service-account JSON (Firebase > Project settings > Service accounts); enables Android server push
FRONTEND_URL=http://localhost:5173   # allowed CORS origin(s), comma separated; also used in emails + share links
BACKEND_URL=http://localhost:4000    # embedded in pushes so notification buttons can call the API
DEFAULT_TIMEZONE=Africa/Nairobi
SMTP_URL=                     # e.g. smtps://user:pass@smtp.example.com ; empty => emails are only logged, NOT sent
MAIL_FROM=CYMOR TO-DO <no-reply@example.com>
UPLOAD_LIMIT_MB=10
SKIP_TTL_INDEXES=0            # set 1 only for MongoDB-compatible stand-ins without TTL index support

# ---- frontend/.env (Vercel project env) ----
# VITE_API_URL=https://your-api.onrender.com     # empty in dev: Vite proxies /api to localhost:4000
